# Reddit API credentials (get from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=coffee_analytics/1.0

# Twitter/X API credentials (get from https://developer.twitter.com)
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here

# Instagram (uses public scraping, no API key needed)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Database
DATABASE_URL=sqlite:///./data/coffee_analytics.db

# App settings
SCRAPE_INTERVAL_HOURS=6
MAX_POSTS_PER_SOURCE=100
